# ====== LLM API（OpenAI 兼容协议，支持 DeepSeek / GLM 等）======
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
# 思考模式：disabled=快速直答(推荐，等价旧deepseek-chat) / enabled=深度思考 / 留空=不发送
LLM_THINKING=disabled

# ====== 向量数据库（Chroma 默认本地运行，无需额外配置）======
